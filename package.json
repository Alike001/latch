{
  "name": "latch",
  "private": true,
  "version": "0.0.1",
  "description": "Software-only machine intelligence recovery for Telegraph Mission 11 Route 2.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
