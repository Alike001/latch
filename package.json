{
  "name": "latch",
  "private": true,
  "version": "0.0.1",
  "description": "Software-only machine intelligence recovery for Telegraph Mission 11 Route 2.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "verify:independent": "npm run typecheck && npm test && npm run validate:fixtures",
    "start:provider": "tsx services/provider-api/src/server.ts",
    "start:web": "tsx apps/web/src/server.ts",
    "validate:miner": "node scripts/validate-stage5-readiness.mjs miner/latch-telemetry.yaml",
    "stage7:live": "tsx scripts/run-stage7-live.ts",
    "stage10:status": "tsx scripts/stage10-evaluator-status.ts",
    "stage10:build-corpus": "tsx evaluator/sensor-telemetry/build-corpus.ts",
    "stage10:check-corpus": "tsx evaluator/sensor-telemetry/check-corpus.ts",
    "stage10:upload-material": "tsx scripts/stage10-upload-evalpool.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "yaml": "^2.8.1"
  }
}
