  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "yaml": "^2.8.1"
  }
}
