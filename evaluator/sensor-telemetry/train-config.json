{
  "hyperparameters": {
    "max_length": 512,
    "batch_size": 1,
    "grad_accum": 16,
    "grad_checkpointing": true,
    "lora_rank": 8,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "epochs": 3,
    "lr": 0.0001,
    "weight_decay": 0.01,
    "eval_split": 0.15,
    "seed": 42,
    "eval_batch": 4,
    "gate_min_acc": 0.65,
    "gate_min_margin_over_baseline": 0.1,
    "early_stopping": true,
    "es_metric": "val_loss",
    "es_patience": 1,
    "es_min_delta": 0.001,
    "loss_floor": 0.0001
  }
}
